local function clearContent()
    for _, child in ipairs(content:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            if child ~= contentTitle then
                child:Destroy()
            end
        end
    end
end

local function addToggle(name)
    local enabled = false

    local button = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = dark,
        Text = name .. "   [ OFF ]",
        TextColor3 = white,
        TextSize = 12,
        Font = Enum.Font.Gotham,
    }, content)
    round(button, 7)

    button.MouseButton1Click:Connect(function()
        enabled = not enabled
        button.Text = name .. (enabled and "   [ ON ]" or "   [ OFF ]")
        button.TextColor3 = enabled and green or white
    end)
end

local pages = {
    Home = {"Welcome to Neon Panel", "GUI is running!"},
    Automation = {"Auto Farm", "Auto Collect", "Auto Quest"},
    Visual = {"Show Names", "Highlight", "Show Effects"},
    Player = {"Walk Speed", "Jump Power"},
    Misc = {"Notifications", "Hide GUI"},
}

local function showPage(name)
    clearContent()
    contentTitle.Text = string.upper(name)

    for _, option in ipairs(pages[name]) do
        if name == "Home" then
            local text = make("TextLabel", {
                Size = UDim2.new(1, 0, 0, 35),
                BackgroundTransparency = 1,
                Text = option,
                TextColor3 = white,
                TextSize = 13,
                Font = Enum.Font.Gotham,
            }, content)
        elseif option == "Hide GUI" then
            local button = make("TextButton", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = green,
                Text = option,
                TextColor3 = dark,
                TextSize = 12,
            }, content)
            round(button, 7)
            button.MouseButton1Click:Connect(function()
                main.Visible = false
                open.Visible = true
            end)
        else
            addToggle(option)
        end
    end
end

for index, name in ipairs({"Home", "Automation", "Visual", "Player", "Misc"}) do
    local button = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = dark,
        Text = name,
        TextColor3 = white,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        LayoutOrder = index,
    }, sidebar)
    round(button, 6)

    button.MouseButton1Click:Connect(function()
        showPage(name)
    end)
end

showPage("Home")

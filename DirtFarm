local activePage = nil
local menuButtons = {}

local function clearSettings()
    for _, child in ipairs(settingsList:GetChildren()) do
        if child:IsA("GuiObject") and not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end
end

local function addSection(text)
    local section = label(settingsList, text, 12, C.Green,
        nil, UDim2.new(1, -4, 0, 25))
    section.Font = Enum.Font.GothamBold
    return section
end

local function addToggle(text)
    local row = create("Frame", {
        Size = UDim2.new(1, -4, 0, 36),
        BackgroundColor3 = C.Panel2,
        BorderSizePixel = 0,
    }, settingsList)
    corner(row, 7)

    label(row, text, 12, C.White,
        UDim2.fromOffset(10, 0), UDim2.new(1, -55, 1, 0))

    local toggle = create("TextButton", {
        Size = UDim2.fromOffset(34, 18),
        Position = UDim2.new(1, -42, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(70, 70, 80),
        Text = "",
        AutoButtonColor = false,
    }, row)
    corner(toggle, 10)

    local knob = create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = C.White,
        BorderSizePixel = 0,
    }, toggle)
    corner(knob, 10)

    local enabled = false

    toggle.MouseButton1Click:Connect(function()
        enabled = not enabled

        TweenService:Create(toggle, TweenInfo.new(0.15), {
            BackgroundColor3 = enabled and C.Green
                or Color3.fromRGB(70, 70, 80)
        }):Play()

        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = enabled and UDim2.fromOffset(18, 2)
                or UDim2.fromOffset(2, 2)
        }):Play()
    end)
end

local function addButton(text, callback)
    local button = create("TextButton", {
        Size = UDim2.new(1, -4, 0, 34),
        BackgroundColor3 = C.Green,
        Text = text,
        TextColor3 = Color3.fromRGB(20, 20, 20),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = true,
    }, settingsList)
    corner(button, 7)

    if callback then
        button.MouseButton1Click:Connect(callback)
    end
end

local function addSlider(text, minValue, maxValue)
    local row = create("Frame", {
        Size = UDim2.new(1, -4, 0, 55),
        BackgroundColor3 = C.Panel2,
        BorderSizePixel = 0,
    }, settingsList)
    corner(row, 7)

    local value = minValue
    label(row, text .. ": " .. value, 12, C.White,
        UDim2.fromOffset(10, 3), UDim2.new(1, -20, 0, 20))

    local bar = create("TextButton", {
        Position = UDim2.fromOffset(10, 32),
        Size = UDim2.new(1, -20, 0, 8),
        BackgroundColor3 = Color3.fromRGB(65, 65, 75),
        Text = "",
        AutoButtonColor = false,
    }, row)
    corner(bar, 5)

    local fill = create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = C.Green,
        BorderSizePixel = 0,
    }, bar)
    corner(fill, 5)

    bar.MouseButton1Click:Connect(function()
        value = value >= maxValue and minValue or value + 1
        local percent = (value - minValue) / (maxValue - minValue)
        fill.Size = UDim2.new(percent, 0, 1, 0)
        row:FindFirstChildWhichIsA("TextLabel").Text =
            text .. ": " .. value
    end)
end

local function showPage(page)
    activePage = page
    clearSettings()
    settingsTitle.Text = "  " .. string.upper(page.name)

    for _, button in ipairs(menuButtons) do
        button.BackgroundColor3 = button.Name == page.name
            and C.Green or C.Panel2
        button.TextColor3 = button.Name == page.name
            and Color3.fromRGB(20, 20, 20) or C.White
    end

    addSection(page.name .. " Settings")

    for _, option in ipairs(page.options) do
        if option == "Walk Speed" then
            addSlider(option, 16, 100)
        elseif option == "Jump Power" then
            addSlider(option, 50, 150)
        elseif option == "Teleport Menu" then
            addButton(option, function()
                addSection("Teleport Menu")
                addButton("Spawn", function()
                    local character = player.Character
                    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation")
                    if character and spawn then
                        character:PivotTo(spawn.CFrame + Vector3.new(0, 4, 0))
                    end
                end)
            end)
        elseif option == "Reset Character" then
            addButton(option, function()
                local character = player.Character
                if character then
                    character:BreakJoints()
                end
            end)
        elseif option == "Hide GUI" then
            addButton(option, function()
                gui.Enabled = false
            end)
        else
            addToggle(option)
        end
    end
end

for index, page in ipairs(pages) do

-- Growtopia-style planting system for Roblox
-- LocalScript: StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

-- Konfigurasi
local seedId = 12
local signBlockId = 5667

local tilesFolder = workspace:WaitForChild("Tiles")
local plantRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("PlantSeed")

local function getTile(x, y)
	for _, tile in ipairs(tilesFolder:GetChildren()) do
		if tile:GetAttribute("X") == x and tile:GetAttribute("Y") == y then
			return tile
		end
	end
	return nil
end

local function getInventoryAmount(itemId)
	-- Sesuaikan dengan sistem inventory game kamu.
	local inventory = player:FindFirstChild("Inventory")
	if not inventory then
		return 0
	end

	local item = inventory:FindFirstChild(tostring(itemId))
	if item and item:IsA("IntValue") then
		return item.Value
	end

	return 0
end

local function moveToTile(tile)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	humanoid:MoveTo(tile.Position)
	humanoid.MoveToFinished:Wait()
end

local function findSignBlocks()
	for _, tile in ipairs(tilesFolder:GetChildren()) do
		if tile:GetAttribute("Foreground") == signBlockId then
			moveToTile(tile)
			task.wait(0.3)
		end
	end
end

local function plantSeed(x, y)
	plantRemote:FireServer(x, y, seedId)
end

local function plant()
	if getInventoryAmount(seedId) <= 4 then
		findSignBlocks()
		return
	end

	for y = 1, 54 do
		for x = 0, 99 do
			if getInventoryAmount(seedId) < 4 then
				return
			end

			local tileDown = getTile(x, y)
			if tileDown then
				local foreground = tileDown:GetAttribute("Foreground")

				if foreground == 2
					or foreground == 10
					or foreground == 4
					or (foreground ~= 0 and foreground ~= seedId) then

					local tileUp = getTile(x, y - 1)

					if tileUp and tileUp:GetAttribute("Foreground") == 0 then
						moveToTile(tileUp)
						task.wait(0.6)
						plantSeed(x, y - 1)
						task.wait(0.25)
					end
				end
			end
		end
	end
end

while true do
	plant()
	task.wait(1)
end

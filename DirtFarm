-- LocalScript

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local running = false

local characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

local function randomWorldName()
    local result = ""

    for i = 1, 4 do
        local index = math.random(1, #characters)
        result ..= characters:sub(index, index)
    end

    return result
end

local function autoWarp()
    while running do
        local worldName = randomWorldName()

        print("Mencoba warp ke:", worldName)

        -- Hubungkan ke API teleport resmi Growblox
        -- setelah pemilik game memberikan dokumentasinya.

        task.wait(3)
    end
end

-- Mulai
running = true
task.spawn(autoWarp)

